# 复制本文件为 .env 并填入真实值

# ---------- LLM ----------
# LLM 服务商: deepseek / openai / ollama / mock（mock=离线自测，无需 Key）
LLM_PROVIDER=deepseek
# API Key（deepseek 去 platform.deepseek.com 申请）
LLM_API_KEY=
# 自定义 base_url（ollama 时填 http://192.168.123.71:11434/v1）
LLM_BASE_URL=https://api.deepseek.com
# 模型名（deepseek-chat / gpt-4o-mini / gemma4:12b 等）
LLM_MODEL=deepseek-chat

# ---------- 输出通道 ----------
# osc=写入 VRChat 聊天框 / console=打印到控制台（调试）
CHATBOX_CHANNEL=osc

# ---------- 语音 ----------
# whisper 模型: tiny/base/small/medium（small 约 460MB，首次自动下载）
WHISPER_MODEL=small
# 触发模式: f8=按住说话(私人) / auto=loopback自动监听(公共,无需按键)
TRIGGER_MODE=both
# f8 模式麦克风设备关键字：空=系统默认输入；填如 EDIFIER 则用该设备当麦克风
# INPUT_DEVICE=
# auto 模式参数（一般不用改）
# 捕获设备关键字：空=默认输出设备；填如 CABLE 则捕获 VB-Cable 输出（VRChat 需路由到它）
# LOOPBACK_DEVICE=
# VAD_THRESHOLD_DB=-35
# VAD_SILENCE_TIMEOUT_S=1.5
# 录音热键（f8 模式）
RECORD_HOTKEY=f8

# ---------- 人设 ----------
# 角色卡名（personas/ 目录下的 json 文件名，空=用第一个）
PERSONA=
